# ==============================================================
# Q-FARM TWIN: Complete Environment Variables Configuration
# ==============================================================

# --------------------------------------------------------------
# 1. FRONTEND (Vite / React 19)
# Note: Vite requires 'VITE_' prefix for variables exposed to client
# --------------------------------------------------------------
# Backend API Base URL (Leave blank to use Vite dev proxy '/api' or set directly e.g. http://127.0.0.1:8000)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Application Metadata
VITE_APP_NAME="Q-FARM TWIN"
VITE_APP_VERSION="2.0.0"
VITE_APP_ENV="development"

# Enable mock data fallback when backend is offline (true / false)
VITE_ENABLE_MOCK_FALLBACK=true

# --------------------------------------------------------------
# 2. BACKEND SERVER (FastAPI / Uvicorn)
# --------------------------------------------------------------
# Server Network Binding
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=true
LOG_LEVEL=info

# Cross-Origin Resource Sharing (CORS) - Comma-separated origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# --------------------------------------------------------------
# 3. QUANTUM COMPUTING & IBM QISKIT ENGINE
# --------------------------------------------------------------
# Quantum Execution Mode: 'simulator' (Local Aer / Statevector) or 'hardware' (Real IBM Quantum QPU)
QUANTUM_EXECUTION_MODE=simulator

# Local Simulator Backend ('aer_simulator' or 'statevector_simulator')
QISKIT_SIMULATOR_BACKEND=aer_simulator

# (Optional) IBM Quantum Platform API Credentials (Only needed for Real Hardware QPUs)
# Get your free token from: https://quantum.ibm.com/
QISKIT_IBM_TOKEN=
QISKIT_IBM_CHANNEL=ibm_quantum
QISKIT_IBM_INSTANCE=ibm-q/open/main

# Number of Qubits for VQR Circuit (Default 3 for simplified, 4 for composite)
QUANTUM_CIRCUIT_QUBITS=3

# Circuit Optimization Level (0 to 3)
QISKIT_OPTIMIZATION_LEVEL=1

# --------------------------------------------------------------
# 4. AGRONOMIC & FARM DIGITAL TWIN SETTINGS
# --------------------------------------------------------------
DEFAULT_CROP=Rice
DEFAULT_FARM_AREA=2.0
DEFAULT_LOCATION="Guntur, Andhra Pradesh"
